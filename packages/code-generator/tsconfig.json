{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "rootDirs": ["./src", "../psd-parser/src"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@codesign/psd-parser": ["../psd-parser/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
